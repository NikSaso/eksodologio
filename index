    );

}


/* ==================================================
   CSV EXPORT
================================================== */

function exportCSV() {

    const rows = [];


    rows.push([
        "Ημερομηνία",
        "Κατηγορία",
        "Ποσό"
    ]);


    Object.keys(data)
    .sort()
    .forEach(ds => {

        categories.forEach(c => {

            const amount =
                Number(
                    data[ds][c.id] || 0
                );


            if (amount > 0) {

                rows.push([
                    ds,
                    c.name.replace(
                        /[^\p{L}\p{N} /&.-]/gu,
                        ""
                    ),
                    amount.toFixed(2)
                ]);

            }

        });

    });


    const csv =
        rows
        .map(row =>
            row.map(
                value =>
                    `"${String(value)
                        .replace(/"/g,'""')}"`
            ).join(";")
        )
        .join("\n");


    /*
       BOM για σωστή εμφάνιση
       ελληνικών στο Excel.
    */

    const blob =
        new Blob(
            ["\uFEFF" + csv],
            {
                type:
                    "text/csv;charset=utf-8;"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const a =
        document.createElement("a");


    a.href = url;

    a.download =
        "exodologio-export.csv";


    a.click();


    URL.revokeObjectURL(url);


    toast(
        "✓ Δημιουργήθηκε CSV"
    );

}


/* ==================================================
   DELETE EVERYTHING
================================================== */

function deleteEverything() {

    const confirmed =
        confirm(
            "ΠΡΟΣΟΧΗ!\n\nΘέλεις να διαγράψεις όλα τα έξοδα από την εφαρμογή;\n\nΑν υπάρχουν αποθηκευμένα στο JSON αρχείο, το αρχείο δεν θα αλλάξει μέχρι να πατήσεις Αποθήκευση."
        );


    if (!confirmed) {
        return;
    }


    data = {};

    budgetData = {};


    saveLocalBackup();

    renderDay();


    toast(
        "✓ Διαγράφηκαν τα δεδομένα από την εφαρμογή"
    );

}


/* ==================================================
   KEYBOARD SHORTCUTS
================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        /*
           Ctrl + S
        */

        if (
            event.ctrlKey &&
            event.key.toLowerCase() === "s"
        ) {

            event.preventDefault();

            saveToFile();

        }

        /*
           Alt + ←
        */

        if (
            event.altKey &&
            event.key === "ArrowLeft"
        ) {

            previousDay();

        }

        /*
           Alt + →
        */

        if (
            event.altKey &&
            event.key === "ArrowRight"
        ) {

            nextDay();

        }

    }
);


/* ==================================================
   START
================================================== */

loadLocalBackup();

renderDay();

</script>

