/* ==================================================
   LOCAL BACKUP
================================================== */

/*
   Κρατάμε και ένα μικρό backup
   στο browser.

   Αυτό ΔΕΝ αντικαθιστά το JSON αρχείο.
*/

function saveLocalBackup() {

    localStorage.setItem(
        "expense_backup",
        JSON.stringify({
            data: data,
            budget: budgetData
        })
    );

}


function loadLocalBackup() {

    try {

        const raw =
            localStorage.getItem(
                "expense_backup"
            );


        if (!raw) {
            return;
        }


        const obj =
            JSON.parse(raw);


        data =
            obj.data || {};


        budgetData =
            obj.budget || {};


    } catch(e) {

        console.log(e);

    }

}


/* ==================================================
   FILE SYSTEM ACCESS API
================================================== */

async function connectFile() {

    if (!window.showOpenFilePicker) {

        alert(
            "Ο browser σου δεν υποστηρίζει απευθείας σύνδεση με αρχείο.\n\nΧρησιμοποίησε Google Chrome ή Microsoft Edge."
        );

        return;

    }


    try {

        const handles =
            await window.showOpenFilePicker({
                types: [
                    {
                        description:
                            "JSON αρχείο εξοδολόγιου",
                        accept: {
                            "application/json":
                                [".json"]
                        }
                    }
                ],
                multiple: false
            });


        fileHandle =
            handles[0];


        await loadFromFile();


        document.getElementById(
            "fileStatus"
        ).textContent =
            "📂 " +
            (await fileHandle.getFile()).name;


        toast(
            "✓ Το αρχείο συνδέθηκε"
        );


    } catch(error) {

        console.log(error);

    }

}


/* ==================================================
   SAVE TO JSON FILE
================================================== */

async function saveToFile(showMessage = true) {

    if (!fileHandle) {

        /*
           Αν δεν έχει συνδεθεί αρχείο,
           ζητάμε από τον χρήστη να επιλέξει
           πού θα δημιουργηθεί.
        */

        if (!window.showSaveFilePicker) {

            downloadJSON();

            return;

        }


        try {

            fileHandle =
                await window.showSaveFilePicker({

                    suggestedName:
                        "exodologio.json",

                    types: [
                        {
                            description:
                                "JSON αρχείο",
                            accept: {
                                "application/json":
                                    [".json"]
                            }
                        }
                    ]

                });

        } catch(error) {

            return;

        }

    }


    const fileData = {

        version: 1,

        updated:
            new Date().toISOString(),

        data: data,

        budget: budgetData

    };


    const writable =
        await fileHandle.createWritable();


    await writable.write(
        JSON.stringify(
            fileData,
            null,
            2
        )
    );


    await writable.close();


    document.getElementById(
        "fileStatus"
    ).textContent =
        "💾 Αποθηκευμένο: " +
        (await fileHandle.getFile()).name;


    saveLocalBackup();


    if (showMessage) {

        toast(
            "✓ Αποθηκεύτηκε στο αρχείο"
        );

    }

}


/* ==================================================
   LOAD FROM FILE
================================================== */

async function loadFromFile() {

    if (!fileHandle) {

        if (!window.showOpenFilePicker) {

            alert(
                "Χρησιμοποίησε Chrome ή Edge."
            );

            return;

        }


        try {

            const handles =
                await window.showOpenFilePicker({
                    types: [
                        {
                            description:
                                "JSON",
                            accept: {
                                "application/json":
                                    [".json"]
                            }
                        }
                    ]
                });


            fileHandle =
                handles[0];

        } catch(error) {

            return;

        }

    }


    try {

        const file =
            await fileHandle.getFile();


        const text =
            await file.text();


        if (!text.trim()) {

            data = {};

            budgetData = {};

        } else {

            const obj =
                JSON.parse(text);


            /*
               Υποστηρίζουμε και το format
               της εφαρμογής και απλό JSON.
            */

            if (obj.data) {

                data =
                    obj.data || {};

                budgetData =
                    obj.budget || {};

            } else {

                data = obj;

                budgetData = {};

            }

        }


        saveLocalBackup();


        document.getElementById(
            "fileStatus"
        ).textContent =
            "📂 Φορτώθηκε: " +
            file.name;


        renderDay();


        toast(
            "✓ Τα δεδομένα φορτώθηκαν"
        );


    } catch(error) {

        alert(
            "Δεν ήταν δυνατή η φόρτωση του αρχείου.\n\nΤο αρχείο ίσως δεν είναι έγκυρο JSON."
        );

        console.error(error);

    }

}


/* ==================================================
   DOWNLOAD JSON
================================================== */

function downloadJSON() {

    const fileData = {

        version: 1,

        updated:
            new Date().toISOString(),

        data: data,

        budget: budgetData

    };


    const blob =
        new Blob(
            [
                JSON.stringify(
                    fileData,
                    null,
                    2
                )
            ],
            {
                type:
                    "application/json"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const a =
        document.createElement("a");


    a.href = url;

    a.download =
        "exodologio.json";


    a.click();


    URL.revokeObjectURL(url);

}


/* ==================================================
   NEW DATA FILE
================================================== */

function newDataFile() {

    const confirmed =
        confirm(
            "Θέλεις να δημιουργήσεις νέο εξοδολόγιο;\n\nΤα τρέχοντα δεδομένα θα παραμείνουν στο παλιό αρχείο εφόσον έχουν αποθηκευτεί."
        );


    if (!confirmed) {
